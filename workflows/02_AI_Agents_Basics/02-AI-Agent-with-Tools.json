{
  "name": "02 - AI Agent with Tools (Function Calling)",
  "nodes": [
    {
      "parameters": {
        "content": "🛠️ **02 - การให้เครื่องมือกับ AI Agent (Tools)**\n\nAI ไม่ได้มีแค่ความรู้เดิมๆ แต่สามารถใช้ Tools ค้นหาข้อมูลหรือทำสิ่งที่ทำไม่ได้ เช่น:\n• คำนวณเลขที่ซับซ้อน (Calculator Tool)\n• ค้นหาข้อมูลใหม่ๆ จาก Wikipedia\n• ดึงข้อมูลจาก API ภายนอก (HTTP Request Tool)\n\n💡 นี่คือจุดที่ทำให้ AI Agent แตกต่างจาก Chatbot ธรรมดา!",
        "width": 480,
        "height": 160,
        "color": 6
      },
      "name": "Sticky 0 Intro",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [260, 40]
    },
    {
      "parameters": {},
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [380, 240]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}"
      },
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [600, 240]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": { "temperature": 0.7 }
      },
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [460, 480]
    },
    {
      "parameters": { "sessionKey": "={{ $json.session_id || \"demo-session-2\" }}" },
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.2,
      "position": [620, 480]
    },
    {
      "parameters": {},
      "name": "Calculator Tool",
      "type": "@n8n/n8n-nodes-langchain.toolCalculator",
      "typeVersion": 1,
      "position": [800, 480]
    },
    {
      "parameters": { "language": "en" },
      "name": "Wikipedia Tool",
      "type": "@n8n/n8n-nodes-langchain.toolWikipedia",
      "typeVersion": 1,
      "position": [960, 480]
    },
    {
      "parameters": {
        "name": "weather_api",
        "description": "Get current weather for a city. Provide city name in English.",
        "method": "GET",
        "url": "https://wttr.in/={{$fromAI(\"city\")}}?format=j1"
      },
      "name": "Weather API Tool",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [1120, 480]
    },
    {
      "parameters": {
        "content": "💬 **วิธีทดสอบ**\n\n1. \"(3245 * 12) + 897 = ?\" → Calculator\n2. \"Who founded Apple?\" → Wikipedia\n3. \"Weather in Bangkok?\" → Weather API",
        "width": 440,
        "height": 180,
        "color": 2
      },
      "name": "Sticky 1 Chat",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [800, 40]
    },
    {
      "parameters": {
        "content": "🧰 **Native Tools**\n• calculator - Math calculations\n• wikipedia - General knowledge",
        "width": 320,
        "height": 140,
        "color": 4
      },
      "name": "Sticky 2 Native",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [780, 660]
    },
    {
      "parameters": {
        "content": "⚙️ **Custom Tool**\nweather_api uses wttr.in API\nVariable: {{$fromAI(\"city\")}}",
        "width": 380,
        "height": 140,
        "color": 3
      },
      "name": "Sticky 3 Custom",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1120, 840]
    }
  ],
  "connections": {
    "When chat message received": { "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]] },
    "OpenAI Chat Model": { "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]] },
    "Window Buffer Memory": { "ai_memory": [[{ "node": "AI Agent", "type": "ai_memory", "index": 0 }]] },
    "Calculator Tool": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] },
    "Wikipedia Tool": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] },
    "Weather API Tool": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
