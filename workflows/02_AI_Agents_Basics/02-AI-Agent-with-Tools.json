{
  "name": "02 - AI Agent with Tools (Function Calling)",
  "nodes": [
    {
      "id": "chat-trigger-01",
      "name": "When chat message received",
      "parameters": {
        "options": {
          "responseMode": "responseNodes"
        }
      },
      "position": [380, 240],
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "waitBetweenTries": 1,
      "webhookId": "ai-tools-chat-trigger"
    },
    {
      "id": "ai-agent-01",
      "name": "AI Agent",
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "=You are a helpful AI assistant with access to various tools.\n\n## Available Tools:\n1. **Calculator** - Use for any mathematical calculations\n2. **Wikipedia** - Use for general knowledge and facts\n3. **Weather API** - Use to get current weather for any city\n\nWhen a user asks something that requires using a tool, you MUST call the appropriate tool first before responding."
        }
      },
      "position": [600, 240],
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8
    },
    {
      "id": "openai-model-01",
      "name": "OpenAI Chat Model",
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.7
        }
      },
      "position": [460, 480],
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "memory-01",
      "name": "Window Buffer Memory",
      "parameters": {
        "contextWindowLength": 5,
        "sessionKey": "={{ $json.session_id || 'demo-session-tools' }}"
      },
      "position": [620, 480],
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.2
    },
    {
      "id": "calc-tool-01",
      "name": "Calculator",
      "parameters": {},
      "position": [800, 480],
      "type": "@n8n/n8n-nodes-langchain.toolCalculator",
      "typeVersion": 1
    },
    {
      "id": "wiki-tool-01",
      "name": "Wikipedia",
      "parameters": {},
      "position": [960, 480],
      "type": "@n8n/n8n-nodes-langchain.toolWikipedia",
      "typeVersion": 1
    },
    {
      "id": "weather-tool-01",
      "name": "WeatherAPI",
      "parameters": {
        "url": "https://wttr.in/={{$fromAI('city')}}?format=j1",
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {}
          ]
        }
      },
      "position": [1120, 480],
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1
    },
    {
      "id": "chat-response-01",
      "name": "Respond to Chat",
      "parameters": {
        "message": "={{ $json.output }}"
      },
      "position": [820, 240],
      "type": "@n8n/n8n-nodes-langchain.chat",
      "typeVersion": 1
    },
    {
      "id": "sticky-01",
      "name": "Sticky 0 Intro",
      "parameters": {
        "color": 6,
        "content": "🛠️ **02 - การให้เครื่องมือกับ AI Agent (Tools)**\n\nAI ไม่ได้มีแค่ความรู้เดิมๆ แต่สามารถใช้ Tools ค้นหาข้อมูลหรือทำสิ่งที่ทำไม่ได้ เช่น:\n• คำนวณเลขที่ซับซ้อน (Calculator Tool)\n• ค้นหาข้อมูลใหม่ๆ จาก Wikipedia\n• ดึงข้อมูลจาก API ภายนอก (HTTP Request Tool)\n\n💡 นี่คือจุดที่ทำให้ AI Agent แตกต่างจาก Chatbot ธรรมดา!",
        "height": 160,
        "width": 480
      },
      "position": [260, 40],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "sticky-02",
      "name": "Sticky 1 Chat",
      "parameters": {
        "color": 2,
        "content": "💬 **วิธีทดสอบ**\n\n1. \"(3245 * 12) + 897 = ?\" → Calculator\n2. \"Who founded Apple?\" → Wikipedia\n3. \"Weather in Bangkok?\" → WeatherAPI",
        "height": 180,
        "width": 440
      },
      "position": [800, 40],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "sticky-03",
      "name": "Sticky 2 Native",
      "parameters": {
        "color": 4,
        "content": "🧰 **Native Tools**\n• calculator - Math calculations\n• wikipedia - General knowledge",
        "height": 140,
        "width": 320
      },
      "position": [780, 660],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "sticky-04",
      "name": "Sticky 3 Custom",
      "parameters": {
        "color": 3,
        "content": "⚙️ **Custom Tool**\nweather_api uses wttr.in API\nVariable: {{$fromAI('city')}}",
        "height": 140,
        "width": 380
      },
      "position": [1120, 660],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "sticky-05",
      "name": "Sticky 4 System",
      "parameters": {
        "color": 5,
        "content": "📚 **System Prompt**\nAI ถูกกำหนดให้ใช้ Tools เมื่อจำเป็น\n- Calculator: สำหรับคำนวณ\n- Wikipedia: สำหรับความรู้ทั่วไป\n- WeatherAPI: สำหรับสภาพอากาศ",
        "height": 140,
        "width": 320
      },
      "position": [260, 400],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [
        [
          {
            "index": 0,
            "node": "AI Agent",
            "type": "main"
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "index": 0,
            "node": "Respond to Chat",
            "type": "main"
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "index": 0,
            "node": "AI Agent",
            "type": "ai_languageModel"
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "index": 0,
            "node": "AI Agent",
            "type": "ai_memory"
          }
        ]
      ]
    },
    "Calculator": {
      "ai_tool": [
        [
          {
            "index": 0,
            "node": "AI Agent",
            "type": "ai_tool"
          }
        ]
      ]
    },
    "Wikipedia": {
      "ai_tool": [
        [
          {
            "index": 0,
            "node": "AI Agent",
            "type": "ai_tool"
          }
        ]
      ]
    },
    "WeatherAPI": {
      "ai_tool": [
        [
          {
            "index": 0,
            "node": "AI Agent",
            "type": "ai_tool"
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": []
}
