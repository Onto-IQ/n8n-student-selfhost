      "position": [
        540,
        40
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://official-joke-api.appspot.com/random_joke",
        "sendQuery": false,
        "sendBody": false,
        "options": {}
      },
      "name": "Get Random Joke",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
