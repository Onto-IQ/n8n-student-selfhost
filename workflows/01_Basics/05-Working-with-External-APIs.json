        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"joke_setup\": \"{{ $json.setup }}\",\n  \"joke_punchline\": \"{{ $json.punchline }}\"\n}",
        "options": {}
      },
      "name": "Send to HttpBin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
