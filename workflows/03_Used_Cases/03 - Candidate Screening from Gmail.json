    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an HR recruiter evaluating resumes against job descriptions.\n\nInput:\n- Resume:\n************************\n{{ $json.data }}\n************************\n\n- Job Description:\n************************\n{{ $('Extract Job Description').item.json.data }}\n************************\n\nYour task: Analyze the resume, compare with job description, and return a JSON object with:\n- Firstname: Candidate's first name\n- Lastname: Candidate's last name\n- Age: Candidate's age\n- Gender: Male or Female\n- Education: Highest education level\n- Matching Score: Percentage (0-100) matching job requirements\n- Hire: Either \"Hire\" or \"Not Hire\"\n- Recommendation: Short comment on candidate suitability",
        "hasOutputParser": true,
        "options": {}
      },
      "name": "AI Agent Screening",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2080,
        320
      ]
    },
    {
      "parameters": {
        "content": "🤖 **AI Screening**\n\nAI วิเคราะห์ Resume:\n• เปรียบเทียบกับ Job Description\n• ให้คะแนน Matching Score\n• ตัดสิน Hire/Not Hire\n• แนะนำสั้นๆ",
        "width": 200,
        "height": 140,
        "color": 3
      },
      "name": "Note: AI",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
