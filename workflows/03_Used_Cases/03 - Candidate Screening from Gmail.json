                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "pdf"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "doc-check",
                    "leftValue": "={{ $json.attachments[0].filename?.toLowerCase() }}",
                    "rightValue": ".doc",
                    "operator": {
                      "type": "string",
