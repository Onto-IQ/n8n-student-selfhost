# ============================================================================
# n8n Student Selfhost — ไฟล์ตั้งค่าตัวอย่าง
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ครบทุกตัวที่ไม่มีค่าเริ่มต้น
#   - Windows (cmd)      : copy .env.example .env
#   - Windows (PowerShell): Copy-Item .env.example .env
#   - macOS / Linux      : cp .env.example .env
# ไฟล์ .env มีความลับ ห้ามอัปโหลดขึ้น GitHub (อยู่ใน .gitignore แล้ว)
# ============================================================================

# ----------------------------------------------------------------------------
# เวอร์ชันของโปรแกรม (pin version ไว้เพื่อให้ทุกเครื่องใช้เวอร์ชันเดียวกัน)
# อัปเดตได้ภายหลัง — ดูหัวข้อ "การอัปเดตเวอร์ชัน" ใน README.md
# ----------------------------------------------------------------------------
N8N_VERSION=2.49.7
CLOUDFLARED_VERSION=2026.11.0

# ----------------------------------------------------------------------------
# Cloudflare Tunnel (ดูขั้นตอนที่ 1-2 ใน README.md)
# ----------------------------------------------------------------------------
# Token ของ tunnel — คัดลอกจาก Cloudflare Zero Trust > Networks > Tunnels >
# สร้าง tunnel แบบ "Docker" แล้วก้อปปี้ค่าหลัง --token (บรรทัดยาว ๆ เริ่มด้วย eyJ...)
TUNNEL_TOKEN=

# Hostname ของ webhook เช่น n8n.example.com หรือ n8n.school-thailand.net
# (ไม่ต้องมี https:// นำหน้า) ต้องตรงกับ Public Hostname ที่ตั้งใน Cloudflare
# dashboard เป๊ะ ๆ มิฉะนั้น URL webhook ที่ n8n สร้างจะไม่ตรงกับของจริง
WEBHOOK_HOST=

# ----------------------------------------------------------------------------
# กุญแจเข้ารหัส credentials ของ n8n — สร้างเอง อย่าใช้ค่าตัวอย่าง
# สร้างครั้งเดียวแล้วเก็บไว้ตลอด ถ้าเปลี่ยน จะเปิด credentials เดิมไม่ได้
#   Git Bash / macOS / Linux : openssl rand -base64 48
#   Windows PowerShell       : [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# ----------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# ฐานข้อมูล PostgreSQL — ตั้งรหัสผ่านเอง อย่าใช้ค่าตัวอย่าง
# บัญชี admin ใช้จัดการฐานข้อมูล / บัญชี n8n คือบัญชีที่ n8n ใช้เชื่อมต่อจริง
# ----------------------------------------------------------------------------
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=

POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=

# ----------------------------------------------------------------------------
# เขตเวลา — มีผลกับ Schedule Trigger และฟังก์ชันวันที่ใน workflow
# ใช้ที่อื่นได้ตามชื่อใน https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# ----------------------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok
