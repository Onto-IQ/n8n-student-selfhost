# --- PostgreSQL Database Settings ---
# แนะนำให้เปลี่ยนรหัสผ่านเพื่อความปลอดภัย
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=n8n

# --- n8n General Settings ---
GENERIC_TIMEZONE=Asia/Bangkok

# --- Webhook & URL Settings ---
# โดเมนที่ตั้งค่าไว้ใน Cloudflare (เช่น n8n.your-domain.com) ไม่ต้องใส่ https://
N8N_HOST=n8n.your-domain.com

# Webhook URL เต็ม (ต้องขึ้นต้นด้วย https://) เพื่อให้ n8n สร้าง URL ได้ถูกต้อง
WEBHOOK_URL=https://n8n.your-domain.com/

# --- Cloudflare Tunnel ---
# Token ที่ได้จากการสร้าง Zero Trust Tunnel ในหน้าเว็บ Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- n8n-MCP (Cursor IDE) ---
# สร้าง API Key ที่ n8n → Settings → API แล้วนำไปใส่ใน .cursor/mcp.json
# URL ของ n8n server ภายนอก (ไม่ต้องใส่ /api/v1)
N8N_API_URL=https://n8n.your-domain.com
N8N_API_KEY=your_n8n_api_key_here
